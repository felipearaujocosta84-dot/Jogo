<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnBack"
                style="@style/SmallButton"
                android:minWidth="48dp"
                android:text="◂" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:letterSpacing="0.1"
                android:shadowColor="@color/neon_blue"
                android:shadowRadius="12"
                android:text="@string/profiles_title"
                android:textColor="@color/neon_blue"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
            <Button android:id="@+id/btnNewProfile" style="@style/NeonButton.Filled" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:textSize="14sp" android:text="@string/profiles_new" />
            <Button android:id="@+id/btnImport" style="@style/NeonButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="6dp" android:textSize="14sp" android:text="@string/profiles_import" />
        </LinearLayout>

        <TextView android:id="@+id/profilesEmpty" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_card" android:padding="16dp" android:text="@string/profiles_empty" />
        <LinearLayout android:id="@+id/profileList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
