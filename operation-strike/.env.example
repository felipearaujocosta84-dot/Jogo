# Copie para .env (no servidor) e preencha. NUNCA coloque este arquivo no app nem no Git.
PORT=8080
HOST=127.0.0.1
# PostgreSQL de produção (troque usuário/senha/banco)
DATABASE_URL=postgres://opstrike:TROQUE_ESTA_SENHA@127.0.0.1:5432/opstrike
# Origens que podem usar a API (o app Android usa http://localhost; o site, o seu domínio)
ALLOWED_ORIGINS=https://jogo.seudominio.com.br,http://localhost,https://localhost,capacitor://localhost
# Atrás do Caddy/nginx: usa o IP real do jogador nos limites de tentativas
TRUST_PROXY=1
SESSION_DAYS=30
RECONNECT_SECONDS=60
LOG_LEVEL=info
