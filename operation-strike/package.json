{
  "name": "operation-strike",
  "private": true,
  "version": "0.1.0",
  "description": "OPERATION STRIKE - FPS competitivo 5v5 em Babylon.js + TypeScript, para navegador e Android",
  "type": "module",
  "scripts": {
    "dev": "node scripts/assetmanifest.mjs && vite --host",
    "build": "node scripts/assetmanifest.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "start": "tsx server/index.ts",
    "server": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test:sim": "tsx scripts/simtest.ts"
  },
  "dependencies": {
    "@babylonjs/core": "9.32.1",
    "@babylonjs/loaders": "9.32.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@colyseus/core": "0.18.25",
    "@colyseus/schema": "5.0.43",
    "@colyseus/sdk": "0.18.9",
    "@colyseus/ws-transport": "0.18.4",
    "pg": "8.23.1",
    "tsx": "4.20.6",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "22.15.30",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "vite": "8.3.3"
  }
}
