{
  "name": "extreme-racing",
  "private": true,
  "version": "1.0.2",
  "description": "EXTREME RACING — jogo de corrida 3D para Android (Babylon.js + Havok + Capacitor)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node tests/physics.test.mjs",
    "android:add": "npx cap add android",
    "android:setup": "node scripts/android-setup.mjs",
    "android:sync": "vite build && npx cap sync android",
    "android:open": "npx cap open android",
    "apk": "node scripts/build-apk.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^7.40.0",
    "@babylonjs/havok": "^1.3.10",
    "@babylonjs/loaders": "^7.40.0",
    "@babylonjs/materials": "^7.40.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/splash-screen": "^6.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0",
    "vite": "^5.4.11"
  }
}
